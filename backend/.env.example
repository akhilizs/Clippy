# Copy this file to .env (run.sh / run.bat do it for you) and fill in your key.

# Your Anthropic API key from https://console.anthropic.com (Settings -> API keys).
# Without it Clippy still works, but picks the loudest moments instead of the most viral ones.
ANTHROPIC_API_KEY=

# The Claude model that picks clips. claude-opus-5-5 gives the best picks (~$0.30-0.50 per hour of video).
CLAUDE_MODEL=claude-opus-5-5

# Speech-to-text model size: tiny, base, small, medium, large-v3. Bigger = more accurate but slower.
WHISPER_MODEL=small

# How many clips to make from each video.
CLIPPY_MAX_CLIPS=8

# Optional: where videos and clips are stored (default: backend/data).
# CLIPPY_DATA_DIR=

# Optional: fixed access code instead of the generated one.
# CLIPPY_TOKEN=
